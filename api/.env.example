# Copy to .env and fill in. Every value can also be set as a real environment variable.

# SQLite locally; the Neon Postgres URL when hosted (same database the site used before).
DATABASE_URL=sqlite:///./respite.db
# Long random string. Signs owner login tokens. Changing it logs everyone out.
JWT_SECRET=
# Token lifetime in minutes (default 7 days)
JWT_MINUTES=10080

# The public website, for pay links and Stripe return URLs
SITE_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API directly (the site calls it server-side)
CORS_ORIGINS=http://localhost:3000

# First owner account, created on startup only when no accounts exist yet
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Owner
# Where new-request and payment alerts go
OWNER_EMAIL=

# Blank = test-mode payments (no real money)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Blank = emails print to the API's terminal
RESEND_API_KEY=
EMAIL_FROM=Respite for the Weary <hello@example.com>

# Protects /cron/bill-rent
CRON_SECRET=

# Room photos: Vercel Blob when set, otherwise UPLOAD_DIR (defaults to ../web/public/uploads)
BLOB_READ_WRITE_TOKEN=
# UPLOAD_DIR=
# Set to true on hosts with a read-only disk and no Blob token, to hide the uploader
READ_ONLY_DISK=false

# Notifications. Every email goes through an outbox table and is retried with backoff (1m, 5m, 30m, 2h).
# The worker runs inside the API. On hosts that can't keep a background thread (serverless), set
# NOTIFY_WORKER=false and call GET /cron/notifications with the CRON_SECRET every minute instead.
NOTIFY_WORKER=true
NOTIFY_POLL_SECONDS=15
