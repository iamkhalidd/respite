# The website is the front end only. Data, logins, payments and email live in the FastAPI backend (../api).
# Where the Next.js server reaches the API. Browsers never call it directly.
API_URL="http://127.0.0.1:8000"

# The public address of this site, used for the resident pay link shown on the dashboard.
SITE_URL="http://localhost:3000"

# Set to 1 on the showcase deploy: hides it from search engines and turns off photo uploads.
# SHOWCASE=1
